      "defines": ["__3DS__"],
      "compilerPath": "${env:DEVKITARM}/bin/arm-none-eabi-gcc",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "gcc-arm"
    }
  ],
  "version": 4
}
